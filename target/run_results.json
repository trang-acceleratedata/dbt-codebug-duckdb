      "unique_id": "model.codebug.fct_opportunity",
      "compiled": true,
      "compiled_code": "-- BUG: won_amount must be 0 for opportunities that were not won.\n-- This computes it as `amount` for every row, so lost opportunities carry a\n-- non-zero won_amount. The singular test tests/assert_won_amount_zero_when_not_won.sql\n-- catches it. Correct logic: case when is_won then amount else 0 end.\nselect\n    opportunity_id,\n    account_id,\n    opportunity_name,\n    stage_name,\n    amount,\n    close_date,\n    is_won,\n    case when is_won then amount else 0 end as won_amount\nfrom \"fixture-check\".\"main\".\"stg_opportunities\"",
      "relation_name": "\"fixture-check\".\"main\".\"fct_opportunity\"",
      "batch_results": null
